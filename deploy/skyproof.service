# SkyProof's always-on service: settles batches, runs the watchtower, executes
# payouts, re-exports the website's data every minute, and serves /api/demo/.
# Install: sudo cp deploy/skyproof.service /etc/systemd/system/ && sudo systemctl enable --now skyproof
[Unit]
Description=SkyProof watchtower and judge demo API
After=network-online.target
Wants=network-online.target

[Service]
User=skyproof
WorkingDirectory=/home/skyproof/skyproof/rollup
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=SKYPROOF_WEB_OUT=/var/www/skyproof/skyproof.json
ExecStart=/usr/local/bin/node --import tsx src/cli/service.ts
Restart=always
# Only the main process gets SIGTERM; it waits for a running chain write, then exits.
KillMode=mixed
TimeoutStopSec=330
RestartSec=10
MemoryMax=600M

[Install]
WantedBy=multi-user.target
